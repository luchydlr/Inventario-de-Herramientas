var SHEET_ID_PROP = 'SPREADSHEET_ID';

function setup() {
  var props = PropertiesService.getScriptProperties();
  var existing = props.getProperty(SHEET_ID_PROP);
  var ss;
  if (existing) {
    ss = SpreadsheetApp.openById(existing);
  } else {
    ss = SpreadsheetApp.create('Control de Herramientas - Base de datos');
    props.setProperty(SHEET_ID_PROP, ss.getId());
  }

  ensureSheet(ss, 'Tools', ['id', 'code', 'name', 'category', 'quantity', 'available', 'photo']);
  ensureSheet(ss, 'Team', ['id', 'name', 'email', 'phone', 'username', 'passwordHash']);
  ensureSheet(ss, 'Loans', ['id', 'toolId', 'toolName', 'borrowerName', 'borrowerEmail', 'lenderId', 'lenderName', 'loanDate', 'expectedReturnDate', 'returnDate', 'lastNotifiedDate', 'quantity']);
  ensureSheet(ss, 'Locations', ['id', 'name']);

  var def = ss.getSheetByName('Hoja 1') || ss.getSheetByName('Sheet1');
  if (def && ss.getSheets().length > 1) ss.deleteSheet(def);

  var triggers = ScriptApp.getProjectTriggers();
  var already = triggers.some(function (t) { return t.getHandlerFunction() === 'checkOverdueLoans'; });
  if (!already) {
    ScriptApp.newTrigger('checkOverdueLoans').timeBased().everyDays(1).atHour(8).create();
  }

  Logger.log('Listo. Hoja de cálculo: ' + ss.getUrl());
  return ss.getUrl();
}

function ensureSheet(ss, name, headers) {
  var sheet = ss.getSheetByName(name);
  if (!sheet) {
    sheet = ss.insertSheet(name);
    sheet.appendRow(headers);
    sheet.setFrozenRows(1);
  }
  return sheet;
}

function getSS() {
  var id = PropertiesService.getScriptProperties().getProperty(SHEET_ID_PROP);
  if (!id) throw new Error('Ejecuta la función setup() primero desde el editor de Apps Script.');
  return SpreadsheetApp.openById(id);
}

// ================= API WEB =================
function doGet(e) {
  return jsonOut({ ok: true, message: 'API de Control de Herramientas activa.' });
}

function doPost(e) {
  try {
    var body = JSON.parse(e.postData.contents);
    var action = body.action;
    var payload = body.payload || {};
    var result;
    switch (action) {
      case 'getData': result = getData(); break;
      case 'addTool': result = addTool(payload); break;
      case 'addLocation': result = addLocation(payload); break;
      case 'deleteTool': result = deleteTool(payload); break;
      case 'addTeamMember': result = addTeamMember(payload); break;
      case 'deleteTeamMember': result = deleteTeamMember(payload); break;
      case 'login': result = login(payload); break;
      case 'whoami': result = whoami(payload); break;
      case 'registerLoan': result = registerLoan(payload); break;
      case 'registerMultiLoan': result = registerMultiLoan(payload); break;
      case 'registerReturn': result = registerReturn(payload); break;
      default: throw new Error('Accion no reconocida: ' + action);
    }
    return jsonOut({ ok: true, data: result });
  } catch (err) {
    return jsonOut({ ok: false, error: err.message });
  }
}

function jsonOut(obj) {
  return ContentService.createTextOutput(JSON.stringify(obj)).setMimeType(ContentService.MimeType.JSON);
}

// ================= HELPERS =================
function sheetToObjects(sheet) {
  var values = sheet.getDataRange().getValues();
  var headers = values[0];
  var rows = values.slice(1);
  return rows.filter(function (r) { return r.join('') !== ''; }).map(function (r) {
    var obj = {};
    headers.forEach(function (h, i) {
      var val = r[i];
      if (val instanceof Date) {
        if (h === 'loanDate') {
          val = Utilities.formatDate(val, Session.getScriptTimeZone(), "yyyy-MM-dd'T'HH:mm:ss");
        } else {
          val = Utilities.formatDate(val, Session.getScriptTimeZone(), 'yyyy-MM-dd');
        }
      }
      obj[h] = val;
    });
    return obj;
  });
}

function findRowIndexById(sheet, id) {
  var values = sheet.getDataRange().getValues();
  for (var i = 1; i < values.length; i++) {
    if (String(values[i][0]) === String(id)) return i + 1;
  }
  return -1;
}

// ================= DATOS =================
function getData() {
  var ss = getSS();
  var team = sheetToObjects(ss.getSheetByName('Team')).map(function (t) {
    return { id: t.id, name: t.name, email: t.email, phone: t.phone, username: t.username };
  });
  return {
    tools: sheetToObjects(ss.getSheetByName('Tools')),
    team: team,
    loans: sheetToObjects(ss.getSheetByName('Loans')),
    locations: sheetToObjects(ss.getSheetByName('Locations')),
    adminEmails: getAdminEmails()
  };
}

