function registerMultiLoan(p) {
  var ss = getSS();
  var loans = ss.getSheetByName('Loans');
  var tools = ss.getSheetByName('Tools');
  var items = p.items || [];
  if (!items.length) throw new Error('No hay herramientas en el préstamo');

  // Validar disponibilidad de todas antes de registrar ninguna
  items.forEach(function (item) {
    var toolRow = findRowIndexById(tools, item.toolId);
    if (toolRow === -1) throw new Error('Herramienta no encontrada: ' + item.toolName);
    var available = Number(tools.getRange(toolRow, 6).getValue()) || 0;
    var qty = Math.max(1, Number(item.quantity) || 1);
    if (qty > available) throw new Error('Solo hay ' + available + ' disponible(s) de ' + item.toolName);
  });

  var createdItems = [];
  items.forEach(function (item) {
    var qty = Math.max(1, Number(item.quantity) || 1);
    var toolRow = findRowIndexById(tools, item.toolId);
    var available = Number(tools.getRange(toolRow, 6).getValue()) || 0;
    var id = Utilities.getUuid();
    loans.appendRow([id, item.toolId, item.toolName, p.borrowerName, p.borrowerEmail || '', p.lenderId || '', p.lenderName, p.loanDate, p.expectedReturnDate, '', '', qty]);
    tools.getRange(toolRow, 6).setValue(available - qty);
    createdItems.push({ name: item.toolName, quantity: qty });
  });

  var itemsText = createdItems.map(function (it) { return '- ' + it.name + ' x' + it.quantity; }).join('\n');
  var asunto = 'Confirmacion de prestamo registrado';
  var cuerpo = 'Se registro un prestamo hecho por ' + p.lenderName + ' a nombre de ' + p.borrowerName + ' con las siguientes herramientas:\n\n' +
    itemsText + '\n\n' +
    'Fecha de prestamo: ' + p.loanDate + '\n' +
    'Fecha limite de devolucion: ' + p.expectedReturnDate + '\n\n' +
    '— Control de Herramientas';

  var teamEmails = sheetToObjects(ss.getSheetByName('Team'))
    .map(function (t) { return t.email; })
    .filter(function (email) { return email; });
  var bossEmail = getBossEmail();
  var recipients = teamEmails.slice();
  if (bossEmail && recipients.indexOf(bossEmail) === -1) recipients.push(bossEmail);
  recipients = recipients.filter(function (email, i) { return recipients.indexOf(email) === i; });

  if (recipients.length) {
    GmailApp.sendEmail(recipients.join(','), asunto, cuerpo);
  }

  return getData();
}

function registerReturn(p) {
  var ss = getSS();
  var loans = ss.getSheetByName('Loans');
  var tools = ss.getSheetByName('Tools');
  var row = findRowIndexById(loans, p.loanId);
  if (row === -1) throw new Error('Prestamo no encontrado');
  loans.getRange(row, 10).setValue(p.returnDate);
  var toolId = loans.getRange(row, 2).getValue();
  var qty = Number(loans.getRange(row, 12).getValue()) || 1;
  var toolRow = findRowIndexById(tools, toolId);
  if (toolRow > -1) {
    var available = Number(tools.getRange(toolRow, 6).getValue()) || 0;
    var quantity = Number(tools.getRange(toolRow, 5).getValue()) || 0;
    tools.getRange(toolRow, 6).setValue(Math.min(quantity, available + qty));
  }
  return getData();
}

// ================= RECORDATORIOS AUTOMATICOS =================
// Se ejecuta sola todos los dias a las 8am (creado por setup()).
function checkOverdueLoans() {
  var ss = getSS();
  var loans = ss.getSheetByName('Loans');
  var data = loans.getDataRange().getValues();
  var today = new Date();
  today.setHours(0, 0, 0, 0);
  var todayStr = Utilities.formatDate(today, Session.getScriptTimeZone(), 'yyyy-MM-dd');

  for (var i = 1; i < data.length; i++) {
    var row = data[i];
    // columnas: 0 id, 1 toolId, 2 toolName, 3 borrowerName, 4 borrowerEmail,
    //           5 lenderId, 6 lenderName, 7 loanDate, 8 expectedReturnDate,
    //           9 returnDate, 10 lastNotifiedDate
    var returnDate = row[9];
    var lastNotified = row[10];
    if (returnDate) continue;
    if (!row[8]) continue;
    var expected = new Date(row[8]);
    expected.setHours(0, 0, 0, 0);
    if (today <= expected) continue;
    if (lastNotified === todayStr) continue;

    var diasVencido = Math.round((today - expected) / (1000 * 60 * 60 * 24));
    var borrowerEmail = row[4];

    if (borrowerEmail) {
      var asunto = 'Herramienta vencida: ' + row[2];
      var cuerpo = 'Hola ' + row[3] + ',\n\n' +
        'El prestamo de la herramienta "' + row[2] + '" esta vencido hace ' + diasVencido + ' dia(s).\n' +
        'Prestada por: ' + row[6] + '\n' +
        'Fecha de prestamo: ' + row[7] + '\n' +
        'Fecha limite de devolucion: ' + row[8] + '\n\n' +
        'Por favor devuelvela lo antes posible.\n\n— Control de Herramientas';
      GmailApp.sendEmail(borrowerEmail, asunto, cuerpo);
      loans.getRange(i + 1, 11).setValue(todayStr);
    }
  }
}