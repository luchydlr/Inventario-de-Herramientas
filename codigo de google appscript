function addLocation(p) {
  var ss = getSS();
  var sheet = ss.getSheetByName('Locations');
  var existing = sheetToObjects(sheet).some(function(l){ return l.name === p.name; });
  if (!existing) {
    var id = Utilities.getUuid();
    sheet.appendRow([id, p.name]);
  }
  return getData();
}

function addTool(p) {
  var ss = getSS();
  var sheet = ss.getSheetByName('Tools');
  var id = Utilities.getUuid();
  var qty = Math.max(1, Number(p.quantity) || 1);
  sheet.appendRow([id, p.code, p.name, p.category || '', qty, qty, p.photo || '']);
  return getData();
}

function deleteTool(p) {
  requireAdmin(p.token);
  var ss = getSS();
  var sheet = ss.getSheetByName('Tools');
  var row = findRowIndexById(sheet, p.id);
  if (row > -1) sheet.deleteRow(row);
  return getData();
}

function addTeamMember(p) {
  var ss = getSS();
  var sheet = ss.getSheetByName('Team');
  if (!p.username || !p.password) throw new Error('Usuario y contraseña son obligatorios');
  var existing = sheetToObjects(sheet).some(function (t) { return t.username === p.username; });
  if (existing) throw new Error('Ese usuario ya existe, elige otro');
  var id = Utilities.getUuid();
  sheet.appendRow([id, p.name, p.email || '', p.phone || '', p.username, hashPassword(p.password)]);
  return getData();
}

function deleteTeamMember(p) {
  requireAdmin(p.token);
  var ss = getSS();
  var sheet = ss.getSheetByName('Team');
  var row = findRowIndexById(sheet, p.id);
  if (row > -1) sheet.deleteRow(row);
  return getData();
}

function registerLoan(p) {
  var ss = getSS();
  var loans = ss.getSheetByName('Loans');
  var tools = ss.getSheetByName('Tools');
  var qty = Math.max(1, Number(p.quantity) || 1);
  var toolRow = findRowIndexById(tools, p.toolId);
  if (toolRow === -1) throw new Error('Herramienta no encontrada');
  var available = Number(tools.getRange(toolRow, 6).getValue()) || 0;
  if (qty > available) throw new Error('Solo hay ' + available + ' disponible(s)');
  var id = Utilities.getUuid();
  loans.appendRow([id, p.toolId, p.toolName, p.borrowerName, p.borrowerEmail || '', p.lenderId || '', p.lenderName, p.loanDate, p.expectedReturnDate, '', '', qty]);
  tools.getRange(toolRow, 6).setValue(available - qty);
  return getData();
}

