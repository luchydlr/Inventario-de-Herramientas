function setPasswordForMember() {
  var nombreExacto = 'NOMBRE TAL COMO APARECE EN EQUIPO'; // <-- cambia esto
  var username = 'usuario_elegido'; // <-- cambia esto
  var password = 'contraseña_elegida'; // <-- cambia esto

  var ss = getSS();
  var sheet = ss.getSheetByName('Team');
  var data = sheet.getDataRange().getValues();
  for (var i = 1; i < data.length; i++) {
