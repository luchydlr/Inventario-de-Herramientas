}

function isAdminEmail(email) {
  if (!email) return false;
  return getAdminEmails().indexOf(email) > -1;
}

// ================= USUARIOS Y CONTRASEÑAS =================
function hashPassword(password) {
  var digest = Utilities.computeDigest(Utilities.DigestAlgorithm.SHA_256, String(password), Utilities.Charset.UTF_8);
  return digest.map(function (b) {
    var v = (b < 0 ? b + 256 : b).toString(16);
    return v.length === 1 ? '0' + v : v;
  }).join('');
}

function login(p) {
  var ss = getSS();
  var team = sheetToObjects(ss.getSheetByName('Team'));
  var member = team.filter(function (t) { return t.username && t.username === p.username; })[0];
  if (!member) throw new Error('Usuario o contraseña incorrectos');
  if (hashPassword(p.password) !== member.passwordHash) throw new Error('Usuario o contraseña incorrectos');
  var token = Utilities.getUuid();
  CacheService.getScriptCache().put('session_' + token, member.id, 21600); // 6 horas
  return {
    token: token,
    member: { id: member.id, name: member.name, email: member.email },
    isAdmin: isAdminEmail(member.email)
  };
}

function verifyToken(token) {
  if (!token) return null;
  var cache = CacheService.getScriptCache();
  var memberId = cache.get('session_' + token);
  if (!memberId) return null;
  cache.put('session_' + token, memberId, 21600); // renueva la sesion en cada uso
  return memberId;
}

function getMemberById(id) {
  var team = sheetToObjects(getSS().getSheetByName('Team'));
  return team.filter(function (t) { return t.id === id; })[0] || null;
}

function whoami(p) {
  var memberId = verifyToken(p.token);
  if (!memberId) throw new Error('Sesion invalida, inicia sesion de nuevo');
  var member = getMemberById(memberId);
  if (!member) throw new Error('Usuario no encontrado');
  return {
    member: { id: member.id, name: member.name, email: member.email },
    isAdmin: isAdminEmail(member.email)
  };
}

function requireAdmin(token) {
  var memberId = verifyToken(token);
  if (!memberId) throw new Error('Sesion invalida, inicia sesion de nuevo');
  var member = getMemberById(memberId);
  if (!member || !isAdminEmail(member.email)) throw new Error('Solo un administrador puede realizar esta accion');
}

